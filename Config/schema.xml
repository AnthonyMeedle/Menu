<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="../../../../vendor/propel/propel/resources/xsd/database.xsd">
    <table name="menu" namespace="Menu\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER" />
        <column defaultValue="1" name="visible" required="true" type="TINYINT" />
        <column defaultValue="0" name="position" required="true" type="INTEGER" />
        <column defaultValue="0" name="typobj" type="INTEGER" />
        <column defaultValue="0" name="objet" type="INTEGER" />
        <column name="title" size="255" type="VARCHAR" />
        <column name="description" type="CLOB" />
        <column name="chapo" type="LONGVARCHAR" />
        <column name="postscriptum" type="LONGVARCHAR" />
        <behavior name="timestampable" />
        <behavior name="i18n">
            <parameter name="i18n_columns" value="title, description, chapo, postscriptum" />
        </behavior>
    </table>

    <table name="menu_item" namespace="Menu\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER" />
        <column name="menu_id" required="true" type="INTEGER" />
        <column defaultValue="0" name="menu_parent" required="true" type="INTEGER" />
        <column defaultValue="1" name="visible" required="true" type="TINYINT" />
        <column defaultValue="0" name="targetblank" required="true" type="TINYINT" />
        <column defaultValue="0" name="sousmenu" required="true" type="TINYINT" />
        <column defaultValue="0" name="position" required="true" type="INTEGER" />
        <column defaultValue="4" name="typobj" required="true" type="INTEGER" />
        <column defaultValue="0" name="objet" required="true" type="INTEGER" />
        <column name="cssclass" size="255" type="VARCHAR" />
        <column name="icone" size="255" type="VARCHAR" />
        <column name="url" size="2048" type="VARCHAR" />
        <column name="title" size="255" type="VARCHAR" />
        <column name="description" type="CLOB" />
        <column name="chapo" type="LONGVARCHAR" />
        <column name="postscriptum" type="LONGVARCHAR" />
        <foreign-key foreignTable="menu" name="fk_menu_has_menu_item" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="menu_id" />
        </foreign-key>
        <index name="idx_menu_item_tree">
            <index-column name="menu_id" />
            <index-column name="menu_parent" />
            <index-column name="position" />
        </index>
        <behavior name="timestampable" />
        <behavior name="i18n">
            <parameter name="i18n_columns" value="url, title, description, chapo, postscriptum" />
        </behavior>
    </table>

    <external-schema filename="local/config/schema.xml" referenceOnly="true" />
</database>
